# afifo: pointer / full / empty safety and tagged-entry data integrity with two free clocks and free resets
# (multiclock), unbounded by k-induction (yices) at DEPTH 2, 4, 8; port-level no-phantom / no-overflow under any reset
# pattern (ph*, abc pdr, internal properties off); latency of the two crossings (l2, l4: abc pdr, the internal properties plus
# L1 / L2 under -DFORMAL_LAT, which k-induction cannot prove); cover tasks show the properties are not vacuous.
[tasks]
d2   prove d2
d4   prove d4
d8   prove d8
ph2  phantom d2
ph4  phantom d4
cov4 cover d4
l2   latency d2
l4   latency d4

[options]
multiclock on
prove: mode prove
prove: depth 24
phantom: mode prove
latency: mode prove
cover: mode cover
cover: depth 40

[engines]
prove: smtbmc yices
cover: smtbmc yices
phantom: abc pdr
latency: abc pdr

[script]
d2: read -define FDEPTH=2
d4: read -define FDEPTH=4
d8: read -define FDEPTH=8
l2: read -define FDEPTH=2
l4: read -define FDEPTH=4
prove: read -formal -DFORMAL afifo.sv
cover: read -formal -DFORMAL afifo.sv
latency: read -formal -DFORMAL -DFORMAL_LAT afifo.sv
phantom: read -sv afifo.sv
phantom: read -define PHANTOM
read -formal afifo_formal.sv
prep -top afifo_formal

[files]
../../rtl/common/afifo.sv
afifo_formal.sv
