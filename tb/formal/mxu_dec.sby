# mxu_dec: the real decoder alone (docs/spec/mxu.md 6). One outcome per instruction taken (context, M = 0 completion or fault),
# the M = 0 completion only with an empty in-flight FIFO and never together with a context, M = R[m_reg] in 64 bits, the sem_inc
# fields, an instruction reaches D_PUSH only without a fault. Bounded model checking; cover = reachability of the M = 0 cases.
# mxu.sby cannot say this: its stub decoder never makes M = 0.
[tasks]
bmc  bmc
cov  cover

[options]
bmc: mode bmc
bmc: depth 40
cover: mode cover
cover: depth 60

[engines]
smtbmc yices

[script]
read -formal isa_pkg.sv
read -formal mxu_dec.sv
prep -top mxu_dec

[files]
../../isa/gen/isa_pkg.sv
../../rtl/core/mxu_dec.sv
